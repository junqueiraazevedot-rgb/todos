# Copie para .env.local (fora do Git) e preencha com os dados do seu projeto Supabase pessoal.
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# NUNCA coloque aqui service role key, chave da OpenAI, client secret do Google etc.
# Esses segredos ficam só em Supabase Secrets (supabase secrets set ...).
